# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.Python

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Model weights & large binaries ───────────────────────────────────────────
*.pt
*.pth
*.onnx
*.weights
*.engine
*.tflite
*.pb

# ── Dataset (large, download separately) ────────────────────────────────────
data/
!data/.gitkeep

# ── Experiment artifacts (track registry only) ───────────────────────────────
artifacts/runs/
artifacts/mlruns/
artifacts/mlflow-artifacts/
artifacts/checkpoints/
!artifacts/.gitkeep

# ── Environment (lock file IS tracked; local overrides are not) ──────────────
.env
.env.*
!environment.lock          # canonical pinned versions — always track

# ── MLflow local ──────────────────────────────────────────────────────────────
mlruns/
mlflow.db

# ── Ultralytics / YOLO run outputs ────────────────────────────────────────────
runs/
wandb/

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Test / Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
