# MLflow tracking + model registry server (ADR-031).
# Same MLflow version as the clients (environment.lock: mlflow==2.22.5). MLflow 3.x is not an
# option: flwr==1.21.0 pins protobuf<5, which mlflow>=3 cannot satisfy (ADR-002-A1).
FROM python:3.12-slim

# SQLAlchemy as in environment.lock: 2.1 removed sqlalchemy.pool.FallbackAsyncAdaptedQueuePool, which mlflow 2.22.5
# imports, so an unpinned install (2.1.8 on 2026-11-11) cannot start the SQLite backend.
RUN pip install --no-cache-dir mlflow==2.22.5 sqlalchemy==2.0.49

EXPOSE 5000

# Backend: SQLite (the model registry needs a database-backed store).
# Artifacts: stored and SERVED by this server, so clients outside the container upload over HTTP
# instead of writing to a server-local path.
CMD ["mlflow", "server", \
     "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/db/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts"]
